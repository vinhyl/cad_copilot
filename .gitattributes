# Keep vendored three.js files byte-identical on every platform. These are
# pinned by SHA-256 in feature_picker._VENDOR_SHA256 for tamper protection; if
# git line-ending normalization rewrites them (e.g. CRLF on Windows checkouts)
# the hashes no longer match and the offline preview refuses to run. Marking
# them -text/-binary stops any autocrlf/eol conversion.
/vendor/three.module.min.js binary
/vendor/jsm/controls/OrbitControls.js binary
/vendor/jsm/loaders/STLLoader.js binary

# Frontend source + built dist must be byte-identical on every platform so the
# vite/esbuild build is reproducible. Windows' default autocrlf converts checked
# -out .js/.html to CRLF, which changes esbuild's content hash and breaks the
# "dist must match src" CI check on Linux runners. Force LF everywhere under
# frontend/ so Windows and Linux build identical chunks.
frontend/** text=auto eol=lf
